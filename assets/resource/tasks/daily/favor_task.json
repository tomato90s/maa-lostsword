{
    "task": [
        {
            "name": "好感",
            "entry": "好感_入口",
            "group": [
                "daily"
            ],
            "label": "💬好感",
            "default_check": true,
            "option": [
                "Local_FavorLimit"
            ],
            "description": "每天最多7次，已完成角色自动跳过；遇到只播放好感剧情、未消耗每日次数的角色，会换其他角色继续完成。"
        }
    ],
    "option": {
        "Local_FavorLimit": {
            "type": "input",
            "label": "本轮完成对话次数",
            "inputs": [
                {
                    "name": "limit",
                    "label": "完成次数（每日最多7次，0跳过）",
                    "default": "7",
                    "pipeline_type": "int",
                    "verify": "^[0-7]$",
                    "pattern_msg": "填写0至7"
                }
            ],
            "pipeline_override": {
                "LocalFavor_Run": {
                    "action": {
                        "param": {
                            "custom_action_param": {
                                "limit": "{limit}"
                            }
                        }
                    }
                }
            }
        }
    }
}
