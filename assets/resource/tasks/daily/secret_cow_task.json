{
    "task": [
        {
            "name": "秘密奶牛副本",
            "label": "秘密奶牛副本",
            "entry": "LocalSecretCow_Entry",
            "group": ["daily"],
            "default_check": false,
            "option": ["Local_SecretCowCustomCount"],
            "description": "默认只用剩余免费次数，免费用完自动跳过。开启自定义次数后，先用免费次数，再按设置使用铃铛；免费次数不占自定义次数。每轮获得战利品后退场并核对次数、铃铛；不购买或补充铃铛。"
        }
    ],
    "option": {
        "Local_SecretCowCustomCount": {
            "type": "switch",
            "label": "使用自定义次数",
            "description": "关闭：忽略自定义数值，只用剩余免费次数。开启：额外使用铃铛，自定义数值是本周脚本使用铃铛的次数上限，免费次数另算。",
            "default_case": "No",
            "cases": [
                {"name": "Yes", "label": "开启", "option": ["Local_SecretCowLimit"], "pipeline_override": {"LocalSecretCow_Entry": {"action": {"param": {"custom_action_param": {"use_custom_count": true}}}}}},
                {"name": "No", "label": "关闭", "pipeline_override": {"LocalSecretCow_Entry": {"action": {"param": {"custom_action_param": {"use_custom_count": false}}}}}}
            ]
        },
        "Local_SecretCowLimit": {
            "type": "input",
            "label": "秘密奶牛副本设置",
            "inputs": [
                {"name": "limit", "label": "本周铃铛次数上限（免费另算）", "default": "10", "pipeline_type": "int", "verify": "^(?:0|[1-9][0-9]?)$", "pattern_msg": "填写0至99；0只用免费次数，每次额外挑战消耗1铃铛"}
            ],
            "pipeline_override": {
                "LocalSecretCow_Entry": {"action": {"param": {"custom_action_param": {"limit": "{limit}"}}}}
            }
        }
    }
}
